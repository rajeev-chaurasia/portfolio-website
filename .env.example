# SMTP server hostname used by the contact form (e.g. smtp.gmail.com)
SMTP_HOST=

# SMTP port (587 for STARTTLS, 465 for implicit TLS)
SMTP_PORT=587

# 'true' only for implicit TLS (port 465); 'false' for STARTTLS on 587
SMTP_SECURE=false

# SMTP username (also used as the From address of contact emails)
SMTP_USER=

# SMTP password or app-specific password
SMTP_PASS=

# Inbox that receives contact-form submissions
CONTACT_RECEIVER_EMAIL=

# Canonical site URL (no trailing slash) — used for sitemap, robots, JSON-LD, metadata
NEXT_PUBLIC_SITE_URL=https://rajeev-chaurasia.vercel.app

# Optional: GitHub fine-grained token (read-only, public repos) — avoids API rate limits for the projects pipeline
GITHUB_TOKEN=

# Keystatic GitHub-mode credentials (production admin UI) — created by Keystatic's one-time GitHub App setup flow
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
